{
  "name": "MoneyMind AI",
  "short_name": "MoneyMind",
  "description": "Smart personal finance tracker",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0a0a0d",
