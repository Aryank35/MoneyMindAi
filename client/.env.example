# Copy to `client/.env`. Never put secrets here - Vite inlines every
# VITE_* variable into the public JS bundle at build time.

# Base URL of the Express API, including the /api prefix.
# Local:      http://localhost:5000/api
# Production: https://<your-render-service>.onrender.com/api
VITE_API_URL=https://moneymindaiapp.onrender.com
