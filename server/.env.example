# Copy this file to `server/.env` and fill in real values.
# `.env` is gitignored - this template is NOT. Never put real
# credentials in this file; it gets committed.

# MongoDB connection string.
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/moneymind?retryWrites=true&w=majority
# Local:  mongodb://127.0.0.1:27017/moneymind
# Include the database name before the "?" or you connect to `test`.
# URL-encode special characters in the password (@ becomes %40).
MONGO_URL= mongodb+srv://aryan5935kishan_db_user:moneymindai@cluster0.k9ai8kz.mongodb.net/?appName=Cluster0

# Secret used to sign auth tokens (src/controllers/authController.js).
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET= MoneyMindAISecret123

# API port for local dev. Render injects its own PORT in production.
# Do NOT use 5173 - that's the Vite client dev server.
PORT=5000
